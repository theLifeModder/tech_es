{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate commit message template",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "teches_commit_message_generator",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}${/}.infra${/}env${/}bin${/}teches_commit_message_generator${/}src"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}
